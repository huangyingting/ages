{
  "name": "ages",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "description": "长河 Ages: a 3D, animated, bilingual atlas for learning Chinese history (middle & high school)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm test && npm run build && npm run test:e2e",
    "data:terrain": "node scripts/fetch-terrain.ts",
    "data:jiangshan": "node scripts/import-jiangshan.ts",
    "data:areas": "node scripts/compute-areas.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.186.0",
    "pinyin-pro": "^3.29.5",
    "pngjs": "^7.0.0",
    "polygon-clipping": "^0.15.7",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
